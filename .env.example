# =====================================================================
# IDK Clips configuration. Copy to ".env" in this folder and edit.
#
# Every value is optional: the defaults run IDK Clips in local mode on this
# computer. Real environment variables take priority over this file.
# Never commit your real .env file (it is ignored by .gitignore).
# All settings are explained in docs/CONFIGURATION.md.
# The web interface has its own build-time file: frontend/.env.example
# =====================================================================

# --- Run mode ---------------------------------------------------------
# local  : one user, no account, this computer only (default)
# server : accounts; videos are processed on this server
# hybrid : accounts; videos are processed on each user's own paired worker
OPENCLIP_MODE=local
# development | production | test   (production: secure cookies, no /api/docs)
OPENCLIP_ENVIRONMENT=development
OPENCLIP_HOST=127.0.0.1
OPENCLIP_PORT=8000
# Public address of this API (shown in worker pairing commands), server/hybrid mode:
# OPENCLIP_PUBLIC_API_URL=https://api.example.com
# Only when behind a reverse proxy: addresses whose X-Forwarded-For is trusted.
# OPENCLIP_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Security ---------------------------------------------------------
# Web origins allowed to call the API (and, in hybrid mode, workers' bridges).
OPENCLIP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENCLIP_ALLOW_REGISTRATION=true
OPENCLIP_RATE_LIMIT_ENABLED=true
OPENCLIP_RATE_LIMIT_REQUESTS_PER_MINUTE=600

# --- Logging ----------------------------------------------------------
OPENCLIP_LOG_LEVEL=INFO
OPENCLIP_LOG_FORMAT=console

# --- Storage, database and limits ---------------------------------------
OPENCLIP_DATA_DIR=data
OPENCLIP_TOOLS_DIR=tools
# PostgreSQL instead of SQLite (keep the real password out of version control):
# OPENCLIP_DATABASE_URL=postgresql+psycopg://openclip:CHANGE_ME@127.0.0.1:5432/openclip
OPENCLIP_MAX_UPLOAD_MB=4096
OPENCLIP_MAX_VIDEO_MINUTES=240
# Delete source videos after N days unless a user chooses otherwise (0 = keep).
OPENCLIP_DEFAULT_RETENTION_DAYS=0
OPENCLIP_YOUTUBE_LOOKUP_ENABLED=true
OPENCLIP_URL_IMPORT_ENABLED=true

# --- FFmpeg (only if it is not in tools/ffmpeg or on PATH) ----------------
# OPENCLIP_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# OPENCLIP_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# auto | libx264 | h264_nvenc
OPENCLIP_VIDEO_ENCODER=auto

# --- Transcription (faster-whisper) -------------------------------------
OPENCLIP_WHISPER_DEFAULT_MODEL=small
# auto | cpu | cuda
OPENCLIP_WHISPER_DEVICE=auto

# --- Local AI (Ollama) ---------------------------------------------------
OPENCLIP_OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENCLIP_OLLAMA_MODEL=gemma3:4b

# --- Optional external AI (any OpenAI-compatible API; the key stays on the server)
# OPENCLIP_EXTERNAL_AI_BASE_URL=https://api.example.com/v1
# OPENCLIP_EXTERNAL_AI_MODEL=model-name
# OPENCLIP_EXTERNAL_AI_API_KEY=
# OPENCLIP_EXTERNAL_AI_NAME=External provider

# --- Hybrid mode (server side) -------------------------------------------
# OPENCLIP_PAIRING_CODE_MINUTES=10
# OPENCLIP_WORKER_LEASE_SECONDS=90
# OPENCLIP_WORKER_JOB_MAX_ATTEMPTS=3
# OPENCLIP_TRANSFER_TOKEN_MINUTES=30
# OPENCLIP_MAX_WORKERS_PER_USER=5

# --- Worker (on the user's computer) --------------------------------------
# OPENCLIP_AGENT_BRIDGE_PORT=8787
# OPENCLIP_AGENT_AI_PROVIDER=ollama
# Only for a plain-HTTP server on your own trusted network:
# OPENCLIP_AGENT_ALLOW_HTTP=false
