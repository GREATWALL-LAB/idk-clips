# Production API for the public website (hybrid mode). Copy to deploy/api.env.
# deploy/api.env holds the database password: never commit it.
# Steps: docs/DEPLOYMENT.md

OPENCLIP_MODE=hybrid
OPENCLIP_ENVIRONMENT=production
OPENCLIP_HOST=0.0.0.0
OPENCLIP_PORT=8000

# Managed PostgreSQL (for example Supabase); keep sslmode=require.
OPENCLIP_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# The web app's origin and this API's public address.
OPENCLIP_CORS_ORIGINS=https://app.example.com
OPENCLIP_PUBLIC_API_URL=https://api.example.com

# Only the reverse proxy may set X-Forwarded-For (see docs/DEPLOYMENT.md).
OPENCLIP_FORWARDED_ALLOW_IPS=127.0.0.1

OPENCLIP_ALLOW_REGISTRATION=true
OPENCLIP_DEFAULT_RETENTION_DAYS=30
OPENCLIP_LOG_FORMAT=json
# Hybrid servers never store or process video.
OPENCLIP_URL_IMPORT_ENABLED=true

# Email verification (required in production): a Supabase project for one-time codes.
# Use the public anon/publishable key, never the service-role key. See deploy/supabase/README.md.
OPENCLIP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
OPENCLIP_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
