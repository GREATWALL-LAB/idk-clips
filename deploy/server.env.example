# Settings for docker/docker-compose.yml (server mode). Copy to deploy/server.env.
# deploy/server.env holds real passwords: never commit it.

# Password for the bundled PostgreSQL container (generate a long random value).
POSTGRES_PASSWORD=CHANGE_ME

OPENCLIP_MODE=server
OPENCLIP_ENVIRONMENT=production
# The address people use to open the site (no trailing slash, no wildcard).
OPENCLIP_CORS_ORIGINS=https://clips.example.com
OPENCLIP_PUBLIC_API_URL=https://clips.example.com
OPENCLIP_ALLOW_REGISTRATION=true
# A reverse proxy on the Docker host reaches the container through the bridge network.
OPENCLIP_FORWARDED_ALLOW_IPS=172.16.0.0/12
OPENCLIP_DEFAULT_RETENTION_DAYS=30
OPENCLIP_MAX_UPLOAD_MB=4096
OPENCLIP_WHISPER_DEFAULT_MODEL=small

# Email verification (required in production): a Supabase project for one-time codes.
# Use the public anon/publishable key, never the service-role key. See deploy/supabase/README.md.
OPENCLIP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
OPENCLIP_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
