# IDK Clips web interface: build-time settings (copy to "frontend/.env.local").
#
# NEXT_PUBLIC_* values are embedded in the JavaScript sent to every visitor.
# Never put secrets or API keys here. Rebuild (or restart "npm run dev") after changes.

# Where the browser reaches the API.
# - Leave unset for a production build served by the backend itself (local mode,
#   self-hosting on one domain): the site then calls its own origin.
# - "npm run dev" defaults to http://localhost:8000.
# - Hosted site: the API's public address, on the same site as the web app so the
#   SameSite=Lax session cookie works (for example app.example.com + api.example.com).
# NEXT_PUBLIC_API_URL=https://api.example.com

# Public repository (https only). GitHub links stay hidden until this is set, so the site
# never shows a placeholder link.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/<owner>/<repository>

# Public address of the hosted website (https only). Used for canonical, Open Graph and
# social-card links. Leave unset for local mode.
# NEXT_PUBLIC_SITE_URL=https://clips.example.com
